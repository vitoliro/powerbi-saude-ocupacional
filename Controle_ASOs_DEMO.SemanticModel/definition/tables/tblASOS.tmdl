	column 'DIAS ANTECIPAÇÃO AGENDADO'
		dataType: int64
		formatString: 0
		lineageTag: 998359d0-3110-4d22-bae8-7fc099b84e44
		summarizeBy: none
		sourceColumn: DIAS ANTECIPAÇÃO AGENDADO

		annotation SummarizationSetBy = Automatic

	partition tblASOS = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "Base_Controle_ASOs_DEMO.xlsx"), null, true),
				    Tabela = Fonte{[Item="tblASOS",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabela, {{"CPF", type text}, {"NOME", type text}, {"CHAPA", type text}, {"EMPRESA", type text}, {"CNPJ", type text}, {"POSTO DE TRABALHO - GHE", type text}, {"FUNÇÃO", type text}, {"UNIDADE DE NEGÓCIO", type text}, {"ADMISSÃO", type date}, {"E-MAIL", type text}, {"GESTOR DIRETO", type text}, {"VENCIMENTO", type text}, {"DATA DE VENCIMENTO", type date}, {"STATUS", type text}, {"STATUS FINAL", type text}, {"ÚLTIMO ASO", type date}, {"DATA DE AGENDAMENTO", type date}, {"TIPO DE ASO", type text}}),
				    DiasParaVencer = Table.AddColumn(Tipos, "DIAS PARA VENCER", each Duration.Days([DATA DE VENCIMENTO] - DataReferencia), Int64.Type),
				    NaBase = Table.AddColumn(DiasParaVencer, "NA BASE", each List.Contains({"Ativo", "Férias", "Licença Remunerada"}, [STATUS]) and [VENCIMENTO] <> "EXCEÇÃO DIRETORIA", type logical),
				    Faixa = Table.AddColumn(NaBase, "FAIXA 90D", each
				        if [DIAS PARA VENCER] < 0 then "Vencido"
				        else if [DIAS PARA VENCER] <= 7 then "Até 7 dias"
				        else if [DIAS PARA VENCER] <= 30 then "8 a 30 dias"
				        else if [DIAS PARA VENCER] <= 60 then "31 a 60 dias"
				        else if [DIAS PARA VENCER] <= 90 then "61 a 90 dias"
				        else "Acima de 90 dias", type text),
				    Situacao = Table.AddColumn(Faixa, "SITUAÇÃO AGENDAMENTO", each
				        if [DATA DE AGENDAMENTO] = null then "Sem agendamento"
				        else if [DATA DE AGENDAMENTO] <= DataReferencia then "Realizado"
				        else "Agendado", type text),
				    AntecipacaoAgendado = Table.AddColumn(Situacao, "DIAS ANTECIPAÇÃO AGENDADO", each
				        if [SITUAÇÃO AGENDAMENTO] = "Agendado" then Duration.Days([DATA DE VENCIMENTO] - [DATA DE AGENDAMENTO]) else null, Int64.Type)
				in
				    AntecipacaoAgendado

	annotation PBI_ResultType = Table

