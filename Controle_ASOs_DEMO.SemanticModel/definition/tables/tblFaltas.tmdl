	column 'MÊS ORDEM'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 78c18044-5693-4a24-9bf4-25f43252db25
		summarizeBy: none
		sourceColumn: MÊS ORDEM

		annotation SummarizationSetBy = Automatic

	partition tblFaltas = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "Base_Controle_ASOs_DEMO.xlsx"), null, true),
				    Tabela = Fonte{[Item="tblFaltas",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabela, {{"CPF", type text}, {"NOME", type text}, {"EMPRESA", type text}, {"UNIDADE DE NEGÓCIO", type text}, {"DATA DO AGENDAMENTO", type date}, {"TIPO DE EXAME", type text}, {"SITUAÇÃO", type text}}),
				    Mes = Table.AddColumn(Tipos, "MÊS", each Date.ToText([DATA DO AGENDAMENTO], "MMM/yy", "pt-BR"), type text),
				    MesOrdem = Table.AddColumn(Mes, "MÊS ORDEM", each Date.Year([DATA DO AGENDAMENTO]) * 100 + Date.Month([DATA DO AGENDAMENTO]), Int64.Type)
				in
				    MesOrdem

	annotation PBI_ResultType = Table

