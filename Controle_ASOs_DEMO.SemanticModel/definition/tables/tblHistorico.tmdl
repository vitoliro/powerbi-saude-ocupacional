	partition tblHistorico = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "Base_Controle_ASOs_DEMO.xlsx"), null, true),
				    Tabela = Fonte{[Item="tblHistorico",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabela, {{"DATA DO SNAPSHOT", type date}, {"UNIDADE DE NEGÓCIO", type text}, {"VENCIMENTOS 90 DIAS", Int64.Type}, {"VENCIDOS", Int64.Type}, {"AGENDADOS", Int64.Type}, {"REALIZADOS", Int64.Type}})
