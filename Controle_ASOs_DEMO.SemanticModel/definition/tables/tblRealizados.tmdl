	partition tblRealizados = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "Base_Controle_ASOs_DEMO.xlsx"), null, true),
				    Tabela = Fonte{[Item="tblRealizados",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabela, {{"CPF", type text}, {"NOME", type text}, {"EMPRESA", type text}, {"UNIDADE DE NEGÓCIO", type text}, {"TIPO DE ASO", type text}, {"DATA DE REALIZAÇÃO", type date}, {"VENCIMENTO ANTERIOR", type date}, {"DIAS ANTECIPADOS", Int64.Type}, {"FAIXA DE ANTECIPAÇÃO", type text}}),
				    Mes = Table.AddColumn(Tipos, "MÊS", each Date.ToText([DATA DE REALIZAÇÃO], "MMM/yy", "pt-BR"), type text),
				    MesOrdem = Table.AddColumn(Mes, "MÊS ORDEM", each Date.Year([DATA DE REALIZAÇÃO]) * 100 + Date.Month([DATA DE REALIZAÇÃO]), Int64.Type)
				in
				    MesOrdem

	annotation PBI_ResultType = Table

