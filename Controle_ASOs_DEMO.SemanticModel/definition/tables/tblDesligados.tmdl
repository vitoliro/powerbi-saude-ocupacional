	partition tblDesligados = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "Base_Controle_ASOs_DEMO.xlsx"), null, true),
				    Tabela = Fonte{[Item="tblDesligados",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabela, {{"CPF", type text}, {"NOME", type text}, {"CHAPA", type text}, {"EMPRESA", type text}, {"UNIDADE DE NEGÓCIO", type text}, {"DATA DE DESLIGAMENTO", type date}, {"ÚLTIMO ASO", type date}, {"ORIGEM", type text}, {"REGISTRADO EM", type date}}),
				    Mes = Table.AddColumn(Tipos, "MÊS", each Date.ToText([DATA DE DESLIGAMENTO], "MMM/yy", "pt-BR"), type text),
				    MesOrdem = Table.AddColumn(Mes, "MÊS ORDEM", each Date.Year([DATA DE DESLIGAMENTO]) * 100 + Date.Month([DATA DE DESLIGAMENTO]), Int64.Type)
				in
				    MesOrdem

	annotation PBI_ResultType = Table

